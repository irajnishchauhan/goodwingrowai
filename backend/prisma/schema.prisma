generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==============================
// USER & ORGANIZATION
// ==============================

model Organization {
  id        String   @id @default(uuid())
  name      String
  logoUrl   String?
  gst       String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  permissions Permission[] @relation("RolePermissions")
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id          String   @id @default(uuid())
  action      String // e.g. "CREATE_LEAD", "VIEW_REPORTS"
  description String?
  roles       Role[]   @relation("RolePermissions")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  isActive       Boolean       @default(true)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  roleId         String
  role           Role          @relation(fields: [roleId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  employee       Employee?

  // Audit
  auditLogs     AuditLog[] @relation("UserAudit")
  tasksAssigned Task[]     @relation("AssignedTasks")

  @@index([organizationId])
  @@index([roleId])
}

model Department {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Employee {
  id           String     @id @default(uuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  managerId    String?
  manager      Employee?  @relation("EmployeeToManager", fields: [managerId], references: [id])
  subordinates Employee[] @relation("EmployeeToManager")
  joiningDate  DateTime?
  location     String?
  status       String     @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  expenses    Expense[]
  attendances Attendance[]
  leaves      Leave[]
  leads       Lead[]       @relation("AssignedSalesperson")
  customers   Customer[]   @relation("CustomerSalesperson")

  @@index([userId])
  @@index([departmentId])
  @@index([managerId])
}

// ==============================
// CRM & SALES
// ==============================

model Lead {
  id                String    @id @default(uuid())
  name              String
  company           String?
  mobile            String?   @unique
  whatsapp          String?
  email             String?
  city              String?
  state             String?
  customerType      String?
  vehicleType       String?
  vehicleBrand      String?
  vehicleModel      String?
  variant           String?
  fuel              String?
  currentBattery    String?
  requiredBattery   String?
  source            String?
  campaignId        String?
  campaign          Campaign? @relation(fields: [campaignId], references: [id])
  assignedToId      String?
  assignedTo        Employee? @relation("AssignedSalesperson", fields: [assignedToId], references: [id])
  score             Int       @default(0)
  estimatedValue    Float     @default(0)
  expectedCloseDate DateTime?
  status            String    @default("NEW") // NEW, CONTACTED, QUALIFIED, WON, LOST
  nextFollowup      DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  followups Followup[]

  @@index([campaignId])
  @@index([assignedToId])
}

model Customer {
  id           String    @id @default(uuid())
  name         String
  company      String?
  phone        String?
  whatsapp     String?
  email        String?
  address      String?
  city         String?
  state        String?
  gstin        String?
  customerType String // RETAIL, CORPORATE, B2B
  assignedToId String?
  assignedTo   Employee? @relation("CustomerSalesperson", fields: [assignedToId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  quotations     Quotation[]
  salesOrders    SalesOrder[]
  invoices       Invoice[]
  payments       Payment[]
  warrantyClaims WarrantyClaim[]
  serviceTickets ServiceTicket[]
  vehicles       CustomerVehicle[]

  @@index([assignedToId])
}

model CustomerVehicle {
  id             String       @id @default(uuid())
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  vehicleModelId String
  vehicleModel   VehicleModel @relation(fields: [vehicleModelId], references: [id])
  registrationNo String?
  year           Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([customerId])
  @@index([vehicleModelId])
}

model Followup {
  id           String    @id @default(uuid())
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id])
  followupDate DateTime
  channel      String // CALL, WHATSAPP, EMAIL, MEETING
  notes        String?
  outcome      String?
  nextFollowup DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([leadId])
}

model Task {
  id           String   @id @default(uuid())
  title        String
  assignedToId String
  assignedTo   User     @relation("AssignedTasks", fields: [assignedToId], references: [id])
  priority     String // LOW, MEDIUM, HIGH, CRITICAL
  dueDate      DateTime
  status       String   @default("TODO") // TODO, IN_PROGRESS, COMPLETED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([assignedToId])
}

// ==============================
// PRODUCT MASTER & VEHICLES
// ==============================

model Product {
  id               String   @id @default(uuid())
  sku              String   @unique
  batteryModel     String
  name             String
  batteryType      String?
  category         String?
  subcategory      String?
  brand            String?
  voltage          String?
  ah               String?
  cca              String?
  dimensions       String?
  weight           Float?
  warrantyMonths   Int?
  mrp              Float
  dealerPrice      Float
  distributorPrice Float
  b2bPrice         Float
  costPrice        Float?
  taxRate          Float    @default(18.0)
  hsn              String?
  barcode          String?
  isSerialTracked  Boolean  @default(true)
  isBatchTracked   Boolean  @default(false)
  amazonSku        String?
  amazonAsin       String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  serialNumbers   ProductSerialNumber[]
  compatibilities BatteryCompatibility[]
  inventory       Inventory[]
}

model VehicleBrand {
  id          String         @id @default(uuid())
  name        String         @unique
  vehicleType String // CAR, BIKE, COMMERCIAL, etc.
  models      VehicleModel[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model VehicleModel {
  id        String       @id @default(uuid())
  brandId   String
  brand     VehicleBrand @relation(fields: [brandId], references: [id])
  name      String
  fuelType  String
  startYear Int?
  endYear   Int?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  customerVehicles CustomerVehicle[]
  compatibilities  BatteryCompatibility[]

  @@index([brandId])
}

model BatteryCompatibility {
  id             String       @id @default(uuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  vehicleModelId String
  vehicleModel   VehicleModel @relation(fields: [vehicleModelId], references: [id])
  isRecommended  Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([productId, vehicleModelId])
}

model ProductSerialNumber {
  id            String    @id @default(uuid())
  serialNumber  String    @unique
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  batchNo       String?
  mfgDate       DateTime?
  purchaseDate  DateTime?
  saleDate      DateTime?
  warrantyStart DateTime?
  warrantyEnd   DateTime?
  status        String    @default("IN_STOCK") // IN_STOCK, SOLD, WARRANTY, RETURNED, SCRAPPED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ==============================
// DEALERS & DISTRIBUTORS
// ==============================

model Dealer {
  id           String   @id @default(uuid())
  businessName String
  ownerName    String
  mobile       String   @unique
  whatsapp     String?
  email        String?
  address      String?
  city         String?
  state        String?
  pincode      String?
  gstin        String?
  pan          String?
  territory    String?
  creditLimit  Float    @default(0)
  paymentTerms String?
  tier         String   @default("STANDARD") // PLATINUM, GOLD, SILVER, STANDARD
  targetAmount Float    @default(0)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ==============================
// INVENTORY & WAREHOUSES
// ==============================

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  type      String // CENTRAL, REGIONAL, TRANSIT, DAMAGE
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory Inventory[]
}

model Inventory {
  id              String    @id @default(uuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])
  availableStock  Int       @default(0)
  reservedStock   Int       @default(0)
  inTransit       Int       @default(0)
  damaged         Int       @default(0)
  warrantyStock   Int       @default(0)
  reorderLevel    Int       @default(0)
  reorderQuantity Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

// ==============================
// ORDERS, INVOICES & PAYMENTS
// ==============================

model Quotation {
  id           String    @id @default(uuid())
  quoteNumber  String    @unique
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id])
  totalAmount  Float
  discount     Float     @default(0)
  tax          Float     @default(0)
  grandTotal   Float
  validityDate DateTime?
  status       String    @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([customerId])
}

model SalesOrder {
  id          String   @id @default(uuid())
  orderNumber String   @unique
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  totalAmount Float
  tax         Float    @default(0)
  grandTotal  Float
  status      String   @default("PENDING") // PENDING, APPROVED, DISPATCHED, DELIVERED, CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
}

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id])
  totalAmount   Float
  discount      Float     @default(0)
  cgst          Float     @default(0)
  sgst          Float     @default(0)
  igst          Float     @default(0)
  grandTotal    Float
  dueDate       DateTime?
  status        String    @default("ISSUED") // DRAFT, ISSUED, PARTIAL, PAID, OVERDUE, CANCELLED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payments Payment[]

  @@index([customerId])
}

model Payment {
  id             String   @id @default(uuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  invoiceId      String?
  invoice        Invoice? @relation(fields: [invoiceId], references: [id])
  amount         Float
  paymentMode    String // CASH, UPI, NEFT, RTGS, CHEQUE
  transactionRef String?
  paymentDate    DateTime @default(now())
  status         String   @default("COMPLETED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([customerId])
  @@index([invoiceId])
}

// ==============================
// AFTER SALES
// ==============================

model WarrantyClaim {
  id           String   @id @default(uuid())
  claimNumber  String   @unique
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  serialNumber String
  claimDate    DateTime @default(now())
  problemDesc  String?
  decision     String?
  status       String   @default("SUBMITTED") // SUBMITTED, REVIEW, APPROVED, REJECTED, REPLACED, CLOSED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
}

model ServiceTicket {
  id           String   @id @default(uuid())
  ticketNumber String   @unique
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  issue        String
  priority     String   @default("MEDIUM")
  status       String   @default("OPEN")
  resolution   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
}

// ==============================
// MARKETING, HR & AUDIT
// ==============================

model Campaign {
  id        String    @id @default(uuid())
  name      String
  channel   String
  budget    Float     @default(0)
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  leads Lead[]
}

model Expense {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  category    String
  amount      Float
  expenseDate DateTime
  description String?
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
}

model Attendance {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  checkIn    DateTime
  checkOut   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([employeeId])
}

model Leave {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation("UserAudit", fields: [userId], references: [id])
  action    String
  module    String
  recordId  String?
  prevValue String?
  newValue  String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
}
